  "FletBox modules widgets createPageScaffold.drawer": {
    "prefix": "createPageScaffold.drawer",
    "description": "Make a FletBox modules widgets createPageScaffold.drawer widget",
    "body": [
      "import { runApp, Scaffold, AppBar, Drawer, DrawerItem, Text, Icon, colors, openDrawer } from 'flet-box';",
      "",
      "const App = () => {",
      "    return Scaffold({",
      "        appBar: AppBar({",
      "            title: \"My App\",",
      "            centerTitle: true,",
      "            leading: Icon({ name: \"menu\", onclick: () => openDrawer() })",
      "        }),",
      "        drawer: Drawer({",
      "            header: Text({ text: \"Menu\", size: 20, weight: \"bold\", padding: 20 }),",
      "            body: [",
      "                DrawerItem({ icon: \"home\", label: \"Home\", route: \"/\" }),",
      "                DrawerItem({ icon: \"settings\", label: \"Settings\", route: \"/settings\" })",
      "            ]",
      "        }),",
      "        body: Text({ text: \"Main content\" }),",
      "        backgroundColor: colors.background",
      "    });",
      "};",
      "",
      "runApp(App, 'root');"
    ]
  },
  "FletBox modules widgets createPageScaffold.tabs": {
    "prefix": "createPageScaffold.tabs",
    "description": "Make a FletBox modules widgets createPageScaffold.tabs widget",
    "body": [
      "import { runApp, Scaffold, AppBar, Tabs, Text, colors } from 'flet-box';",
