{
  "name": "flet-box",
  "version": "1.0.3",
  "description": "Declarative, zero-dependency UI framework in vanilla JS — ship web, PWA, Android and iOS from one codebase",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "flet-box": "bin/cli.js"
  },
  "scripts": {
    "dev": "node bin/cli.js run --hot",
    "build": "node bin/cli.js createBundle",
    "release": "node bin/cli.js release",
    "test": "node scripts/check-widgets.mjs && node scripts/check-api-surface.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs"
  },
  "keywords": [
    "fletbox",
    "flet-box",
    "framework",
    "ui",
    "flutter-like",
    "vanilla-js",
    "lightweight",
    "pwa",
    "no-dependencies",
    "zero-deps"
  ],
  "author": "Maenys Javier Quesada Reyes <kuko53348@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuko53348/flet-box.git"
  },
  "homepage": "https://kuko53348.github.io/flet-box-docs/",
  "bugs": {
    "url": "https://github.com/kuko53348/flet-box/issues"
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "esbuild": "^0.28.0",
    "ws": "^8.21.0"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9.0"
  }
}
