{
  "name": "flet-box",
  "version": "1.0.1",
  "description": "Ultra-lightweight UI framework for vanilla JS web apps",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "flet-box": "bin/cli.js"
  },
  "scripts": {
    "dev": "node bin/cli.js run --hot",
    "build": "node bin/cli.js createBundle",
    "test": "node scripts/check-widgets.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "fletbox",
    "flet-box",
    "framework",
    "ui",
    "flutter-like",
    "vanilla-js",
    "lightweight",
    "pwa",
    "no-dependencies",
    "zero-deps"
  ],
  "author": "Maenys Javier Quesada Reyes <kuko53348@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuko53348/flet-box.git"
  },
  "homepage": "https://kuko53348.github.io/flet-box-docs/",
  "bugs": {
    "url": "https://github.com/kuko53348/flet-box/issues"
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "esbuild": "^0.28.0",
    "ws": "^8.21.0"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
